# ===== 필수 =====
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# 비용/응답길이 제한. 필요하면 600~2000 범위에서 조정
OPENAI_MAX_OUTPUT_TOKENS=1200

# Firebase: 아래 둘 중 하나 사용
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=

# 로컬 테스트에서만 true. 최종 제출/배포는 false 권장
USE_MEMORY_DB=true
DEMO_SEED_ON_START=true

# CORS (쉼표 구분)
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# 프론트엔드가 호출할 Render 백엔드 URL
API_BASE_URL=http://127.0.0.1:8000

# 관리자 갱신 API 보호용
ADMIN_REFRESH_TOKEN=change-me

# 공공데이터포털 활용신청 후 발급받은 서비스키
DATA_GO_KR_SERVICE_KEY=
LEGAL_DONG_CODE_API_URL=https://apis.data.go.kr/1741000/StanReginCd/getStanReginCdList
# 대안: 로그인 없이 내려받은 공식 전국 법정동 CSV 경로. 설정하면 bootstrap_regions.py가 CSV를 우선 사용
LEGAL_DONG_CSV_PATH=

# 각 API의 실제 상세기능 URL은 활용신청 화면에서 확인 후 입력
POPULATION_API_URL=https://apis.data.go.kr/1741000/stdgPpltnHhStus/selectStdgPpltnHhStus
AGE_POPULATION_API_URL=https://apis.data.go.kr/1741000/stdgSexdAgePpltn/selectStdgSexdAgePpltn
SINGLE_HOUSEHOLD_API_URL=

# 주민등록 3종은 활용신청 후 상세명세의 파라미터 이름을 JSON template로 입력
# placeholder: {month}, {yyyymm}, {bjd_code}, {sigungu_code}, {bjdong_code}, {region_name}, {full_name}
POPULATION_QUERY_JSON={"stdgCd":"{bjd_code}","srchFrYm":"{yyyymm}","srchToYm":"{yyyymm}","lv":"7","regSeCd":"1","type":"JSON"}
AGE_POPULATION_QUERY_JSON={"stdgCd":"{bjd_code}","srchFrYm":"{yyyymm}","srchToYm":"{yyyymm}","lv":"7","regSeCd":"1","type":"JSON"}
SINGLE_HOUSEHOLD_QUERY_JSON={}
# Swagger가 시군구/전체 조회를 지원할 때만 sigungu/global로 변경. 기본 region이 가장 안전
POPULATION_QUERY_SCOPE=region
AGE_POPULATION_QUERY_SCOPE=region
SINGLE_HOUSEHOLD_QUERY_SCOPE=region
APT_LIST_API_URL=https://apis.data.go.kr/1613000/AptListService4/getLegaldongAptList4
APARTMENT_BASIC_API_URL=https://apis.data.go.kr/1613000/AptBasisInfoServiceV5/getAphusBassInfoV5
BUILDING_REGISTER_API_URL=https://apis.data.go.kr/1613000/BldRgstHubService/getBrTitleInfo
APT_SALE_API_URL=https://apis.data.go.kr/1613000/RTMSDataSvcAptTradeDev/getRTMSDataSvcAptTradeDev
APT_RENT_API_URL=https://apis.data.go.kr/1613000/RTMSDataSvcAptRent/getRTMSDataSvcAptRent
COMMERCE_API_URL=https://apis.data.go.kr/B553077/api/open/sdsc2/storeListInDong
HOUSEHOLD_BIRTH_DEATH_API_URL=
HOUSEHOLD_SIZE_API_URL=
HOUSEHOLD_SIZE_QUERY_JSON={}
HOUSEHOLD_SIZE_QUERY_SCOPE=region
# 출생·사망이 한 API이면 BIRTH_DEATH_* 사용, 별도 API이면 BIRTH_* + DEATH_* 사용
BIRTH_DEATH_API_URL=
BIRTH_DEATH_QUERY_JSON={}
BIRTH_DEATH_QUERY_SCOPE=region
BIRTH_API_URL=
BIRTH_QUERY_JSON={}
BIRTH_QUERY_SCOPE=region
DEATH_API_URL=
DEATH_QUERY_JSON={}
DEATH_QUERY_SCOPE=region
OTHER_REAL_ESTATE_API_URL=
ROWHOUSE_SALE_API_URL=https://apis.data.go.kr/1613000/RTMSDataSvcRHTrade/getRTMSDataSvcRHTrade
SINGLE_HOUSE_SALE_API_URL=https://apis.data.go.kr/1613000/RTMSDataSvcSHTrade/getRTMSDataSvcSHTrade
COMMERCIAL_SALE_API_URL=https://apis.data.go.kr/1613000/RTMSDataSvcNrgTrade/getRTMSDataSvcNrgTrade
# 지역 월간 공매는 입찰결과목록(15157252)을 우선 사용. 주소를 법정지역에 매핑
ONBID_RESULT_API_URL=
ONBID_RESULT_QUERY_JSON={}
# 선택: 별도의 "목록" API가 확보된 경우에만 사용. 15157247 부동산 상세는 물건관리번호가 필수라 bulk 목록용이 아님
ONBID_PROPERTY_API_URL=
ONBID_PROPERTY_QUERY_JSON={}
# KOSIS Benchmark는 CSV import가 기본. OpenAPI를 확장할 경우 아래 인증키/URL을 사용할 수 있음
KOSIS_API_KEY=
KOSIS_API_URL=https://kosis.kr/openapi/statisticsData.do?method=getList

# 데이터 갱신 정책
RECENT_REAL_ESTATE_RECALC_MONTHS=3
ENABLE_ON_DEMAND_REFRESH=false
LIVE_REAL_ESTATE_TTL_HOURS=24
LIVE_ONBID_TTL_HOURS=6
